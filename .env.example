# Next.js Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Add your API endpoints here
# NEXT_PUBLIC_API_URL=https://api.example.com

# Optional: Add analytics tracking
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Add contact service
# CONTACT_EMAIL_SERVICE=smtp://user:password@host:port

# Local MongoDB for auth
MONGODB_URI=mongodb://127.0.0.1:27017/business-hub

# Backend API base URL
# Use your Render backend URL in production
NEXT_PUBLIC_API_URL=http://localhost:5000
